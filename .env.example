# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# Deployment mode — production makes the server fail fast if JWT_SECRET is missing.
HARF_ENV=production

# Postgres (compose derives the backend's DB_JDBC_URL/USER/PASSWORD from these).
POSTGRES_DB=harf
POSTGRES_USER=harf
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# JWT — REQUIRED in production. Generate once:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_ISSUER=harf-backend
JWT_AUDIENCE=harf-client

# App. PORT is the port *inside* the container — leave it at 8080.
PORT=8080
# Each pooled connection is a separate Postgres backend process (~8 MB). Keep this small on
# the 1 GB shapes; raise it only if you actually see connection starvation.
DB_MAX_POOL_SIZE=5

# JVM sizing. Without an explicit cap the JVM claims ~1/4 of *host* RAM for the heap and the
# process RSS lands far higher — enough to OOM a 1 GB box that also runs Postgres.
JAVA_OPTS=-Xmx256m -XX:MaxMetaspaceSize=128m

# Root log level (backend/src/main/resources/logback.xml). DEBUG makes Exposed echo every SQL
# statement it runs — useful when chasing a query, far too noisy to leave on.
LOG_LEVEL=INFO

# Host ports the stack publishes on 127.0.0.1 (never public). Change these if something
# else on the box already owns the port; point Caddy at HARF_HOST_PORT.
HARF_HOST_PORT=8081
DB_HOST_PORT=5432

# OAuth audiences the server accepts.
# Google: the Web/server client id (public). Comma-separate to trust several.
GOOGLE_CLIENT_IDS=508164918683-9rce0g2mrjqn9pcshk33kdf870rg1hua.apps.googleusercontent.com
# Apple: the iOS bundle id(s) — the audience the identity tokens carry. Blank rejects every Apple
# sign-in, so set it before shipping Apple link.
APPLE_AUDIENCES=uz.abumme.harfgame

# Sign in with Apple key, used to revoke Apple tokens when an account is deleted (Apple requires it,
# TN3194). Without all three, linking still works and deletion simply revokes nothing.
# Key and Key ID: Apple Developer -> Certificates, Identifiers & Profiles -> Keys -> Sign in with Apple.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 contents. Prefer mounting the file and pointing at it — a multi-line secret in .env is
# fragile; APPLE_PRIVATE_KEY (with literal \n) is the fallback.
APPLE_PRIVATE_KEY_PATH=
APPLE_PRIVATE_KEY=
# The audience the client secret is signed for; defaults to the first APPLE_AUDIENCES entry.
APPLE_CLIENT_ID=

# Word-suggestion review over Telegram. All optional: a blank bot token disables the bot —
# suggestions are still stored and checked against the dictionary, just not posted, no crash.
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Chat the bot posts to: suggestions for review, auto-accepted words, and the daily reports
# (a group/channel or a user id).
TELEGRAM_EDITOR_CHAT_ID=
# Who may Accept/Reject in Telegram: active staff accounts whose "Telegram ID" (set by an ADMIN in the
# admin panel) matches the tapping user, limited to their languages (an ADMIN decides in every language).
# LEGACY, remove once every editor is a staff account with a linked Telegram ID (docs/deploy-oracle.md §14):
# comma-separated Telegram user ids still allowed to decide in EVERY language. While set, startup logs a warning.
TELEGRAM_EDITOR_IDS=
# Optional per-language forum topics: post each language's suggestions, auto-accepted words and
# daily report into its own topic of the editor chat (a forum supergroup). Format:
# lang=message_thread_id, comma-separated. Languages not listed post to the chat root.
# Example: en=2,ru=3,uz-latn=4,uz-cyrl=5,kk=6
TELEGRAM_TOPICS=

# Automatic acceptance. Each new suggestion is first looked up on English Wiktionary (outbound
# HTTPS to en.wiktionary.org): a real word of its language — dictionary or inflected form — is added
# to the word pack and announced; anything else (not found, a proper noun, abbreviation, misspelling
# or vulgar word, or the dictionary unreachable) goes to editors with Accept/Reject buttons.
# Optional, default true. Set to false to send every suggestion to editors, e.g. if auto-accept
# starts letting bad words through.
WORD_LOOKUP_ENABLED=true

# Staff admin panel (https://<domain>/harf/admin/). The image serves the exported panel itself
# (ADMIN_WEB_DIR is set inside the image; leave it unset here).
#
# First ADMIN: while no active ADMIN exists, the server creates this account at startup — or, if the
# username already exists, makes it an active ADMIN with this password, unlocked (the recovery path when
# no ADMIN can sign in). Ignored while an active ADMIN exists. Username: 3-32 characters of
# a-z 0-9 . _ -; password: 12-128 characters, e.g.  openssl rand -base64 24
# Set them once, sign in, then REMOVE both lines and restart: left in place, they would silently
# recreate or reset that account on any later start without an active ADMIN.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
# Path of the staff session cookies. Production: /harf, so the cookies are never sent to the other
# apps served from the same host. Default /.
ADMIN_COOKIE_PATH=/harf
# true behind Caddy: the staff login rate limit then keys on the client address Caddy reports in
# X-Forwarded-For (the last entry) instead of the Docker bridge gateway. Only safe while the backend
# port is published on 127.0.0.1 and Caddy is its only client. Default false.
TRUST_PROXY_HEADERS=true
# LOCAL DEVELOPMENT ONLY: origin of the Kobweb dev server (./gradlew -PadminWebOnly
# :adminWeb:kobwebStart -t) allowed to call the admin API with credentials. Ignored when
# HARF_ENV=production; leave it empty on the server.
ADMIN_DEV_ORIGIN=

# Daily-word calendar. The public launch date (yyyy-mm-dd): days before it never count as "used", so words
# that were the daily word during the test period are free again for manual and automatic picks after launch.
# Leave empty during testing: each calendar then counts from its first run on the server. A malformed
# date stops the server at startup.
DAILY_HISTORY_START=

le"}, {"tags": ["collocation"], "text": "иска́ть с соба́ками", "bold_text_offsets": [[10, 19]], "roman": "iskátʹ s sobákami", "bold_roman_offsets": [[9, 17]], "translation": "to search with dogs", "english": "to search with dogs", "bold_translation_offsets": [[15, 19]], "type": "example"}, {"tags": ["collocation"], "text": "ну́жный как соба́ке пя́тая нога́", "bold_text_offsets": [[12, 19]], "roman": "núžnyj kak sobáke pjátaja nogá", "bold_roman_offsets": [[11, 17]], "translation": "needed like a hole in the head", "english": "needed like a hole in the head", "literal_meaning": "needed like a dog needs a fifth leg", "type": "example"}, {"tags": ["collocation"], "text": "соба́ка на се́не", "roman": "sobáka na séne", "translation": "dog in the manger", "english": "dog in the manger", "type": "example"}, {"tags": ["collocation"], "text": "соба́ку съесть", "roman": "sobáku sʺjestʹ", "translation": "to know something inside out", "english": "to know something inside out", "type": "example"}, {"tags": ["collocation"], "text": "уста́ть как соба́ка", "roman": "ustátʹ kak sobáka", "translation": "to be dog-tired", "english": "to be dog-tired", "type": "example"}, {"tags": ["collocation"], "text": "пове́сить всех соба́к на кого-либо", "roman": "povésitʹ vsex sobák na kovo-libo", "translation": "to pin accusations upon somebody", "english": "to pin accusations upon somebody", "type": "example"}, {"text": "сторожева́я соба́ка", "bold_text_offsets": [[12, 19]], "roman": "storoževája sobáka", "bold_roman_offsets": [[12, 18]], "translation": "watchdog", "english": "watchdog", "type": "example"}, {"text": "дворо́вая соба́ка", "bold_text_offsets": [[10, 17]], "roman": "dvoróvaja sobáka", "bold_roman_offsets": [[10, 16]], "translation": "cur, mongrel, mutt", "english": "cur, mongrel, mutt", "type": "example"}, {"text": "Вот где соба́ка зарыта!", "bold_text_offsets": [[8, 15]], "roman": "Vot gde sobáka zaryta!", "bold_roman_offsets": [[8, 14]], "translation": "Now I see it!", "english": "Now I see it!", "type": "example"}, {"text": "Его́ ка́ждая соба́ка зна́ет", "bold_text_offsets": [[13, 20]], "roman": "Jevó káždaja sobáka znájet", "bold_roman_offsets": [[13, 19]], "translation": "Everyone knows him.", "english": "Everyone knows him.", "literal_meaning": "Every dog knows him", "type": "example"}, {"text": "голо́дный как соба́ка", "bold_text_offsets": [[14, 21]], "roman": "golódnyj kak sobáka", "bold_roman_offsets": [[13, 19]], "translation": "as hungry as a dog; wolfish, rapacious", "english": "as hungry as a dog; wolfish, rapacious", "type": "example"}, {"text": "замёрзнуть как соба́ка", "bold_text_offsets": [[15, 22]], "roman": "zamjórznutʹ kak sobáka", "bold_roman_offsets": [[16, 22]], "translation": "to be chilled to the marrow", "english": "to be chilled to the marrow", "type": "example"}, {"text": "Собаки народ умный, они знают все политические отношения, и потому, верно, там будет всё: портрет и все дела этого мужа.", "ref": "1835, Николай Гоголь, “Ноября 12.”, in Записки сумасшедшего; English translation from Claud Field, transl., Memoirs of a Madman, 1916:", "english": "Dogs are clever fellows; they know all about politics, and I will certainly find in the letters all I want, especially the character of the director and all his relationships.", "roman": "Sobaki narod umnyj, oni znajut vse političeskije otnošenija, i potomu, verno, tam budet vsjo: portret i vse dela etovo muža.", "type": "quotation", "bold_text_offsets": [[0, 6]], "translation": "Dogs are clever fellows; they know all about politics, and I will certainly find in the letters all I want, especially the character of the director and all his relationships.", "bold_translation_offsets": [[0, 4]]}], "links": [["dog", "dog"]], "synonyms": [{"word": "пёс"}], "glosses": ["dog"], "id": "en-собака-ru-noun-zWNX792W", "categories": [{"name": "Russian terms with collocations", "kind": "other", "parents": [], "source": "w"}, {"name": "Dogs", "kind": "other", "parents": [], "source": "w
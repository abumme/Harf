# Keep the Docker build context small and reproducible.
.git
.gradle
**/.gradle
**/build
**/.kotlin
.idea
*.iml
local.properties
.env
# Client-only sources aren't compiled in a -PbackendOnly build (settings.gradle.kts drops
# those modules). Keeping them out also stops UI edits from invalidating the build cache.
iosApp
webApp
androidApp
desktopApp
sharedUI
# The staff panel (adminWeb/) is exported in its own stage; only its local export and Kobweb server
# files stay out.
adminWeb/.kobweb/site
adminWeb/.kobweb/server
# Not part of any build.
docs
openspec
.github
kotlin-js-store

# Copy to `keystore.properties` (gitignored) and fill in with your upload key.
# Used by androidApp/build.gradle.kts to sign the release AAB/APK.
# Without this file, release builds are left unsigned (debug builds are unaffected).
#
# Create the upload keystore once (2048-bit RSA, ~27 year validity):
#   keytool -genkeypair -v -keystore upload-keystore.jks \
#     -alias harf-upload -keyalg RSA -keysize 2048 -validity 10000
# Keep upload-keystore.jks OUT of git (already covered by *.jks in .gitignore).
# Back it up somewhere safe — losing it means you can't ship updates without a Play key reset.

# Path to the keystore, relative to androidApp/ (or absolute).
storeFile=../upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=harf-upload
keyPassword=CHANGE_ME
